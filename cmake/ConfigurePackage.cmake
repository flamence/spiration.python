set_target_properties(${PROJECT_NAME} PROPERTIES
    RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin"
    LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin"
    ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib"
)

set(LIBRARY_PATH "bin/${CMAKE_SHARED_LIBRARY_PREFIX}${PROJECT_NAME}${CMAKE_SHARED_LIBRARY_SUFFIX}")
configure_file(
    ${CMAKE_CURRENT_SOURCE_DIR}/extension.json
    ${CMAKE_CURRENT_BINARY_DIR}/extension.json
    @ONLY
)
install(FILES ${CMAKE_CURRENT_BINARY_DIR}/extension.json DESTINATION .)

install(TARGETS ${PROJECT_NAME}
    RUNTIME DESTINATION "bin"
    LIBRARY DESTINATION "bin"
    ARCHIVE DESTINATION "lib"
)

# install(DIRECTORY res/
#     DESTINATION "."
# )

install(CODE "
    set(PACKAGE_ROOT \"\${CMAKE_INSTALL_PREFIX}\")
    
    if(EXISTS \"\${PACKAGE_ROOT}/include\")
        file(REMOVE_RECURSE \"\${PACKAGE_ROOT}/include\")
    endif()
    
    if(EXISTS \"\${PACKAGE_ROOT}/lib\")
        file(REMOVE_RECURSE \"\${PACKAGE_ROOT}/lib\")
    endif()
")

set(CPACK_GENERATOR "TGZ")
set(CPACK_PACKAGE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/pkg")
string(TOLOWER "${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}" ARCH_SUFFIX)
set(CPACK_PACKAGE_FILE_NAME "${PROJECT_NAME}-v${PROJECT_VERSION}-${ARCH_SUFFIX}")
set(CPACK_PACKAGE_NAME ${PROJECT_NAME})
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGING_INSTALL_PREFIX "")
include(CPack)
